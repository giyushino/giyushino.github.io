---
layout: base.njk
pageTitle: ayzml writing
permalink: /writing/
navActive: /writing/
screenLabel: writing
---

<section class="content" id="writing">
  <h2 class="big list-head">Loose Collection of Thoughts</h2>

  {% for post in collections.posts %}
    <div class="entry">
      <h3 class="entry__title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.data.draft %}<span class="draft-badge">draft</span>{% endif %}
      </h3>
      <p class="entry__meta">
        {{ post.data.date | longDate }}{% if post.data.updated %}<span class="entry__updated">updated {{ post.data.updated | longDate }}</span>{% endif %}
      </p>
      <p class="entry__blurb">{{ post.data.blurb }}</p>
    </div>
  {% else %}
    <p class="entry__blurb">Nothing here yet.</p>
  {% endfor %}
</section>
