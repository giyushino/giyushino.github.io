---
layout: page.njk
title: Writing
permalink: /writing/
---
<section class="list-page">
  <h1 class="list-head">Loose Collection of Thoughts</h1>

  {%- for post in collections.posts %}
  <div class="entry">
    <h2 class="entry__title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      {%- if post.data.draft %}<span class="draft-badge">draft</span>{% endif %}
    </h2>
    <p class="entry__meta">
      {{ post.date | longDate }}{% if post.data.updated %}<span class="entry__updated">updated {{ post.data.updated | longDate }}</span>{% endif %}
    </p>
    {%- if post.data.blurb %}
    <p class="entry__blurb">{{ post.data.blurb }}</p>
    {%- endif %}
  </div>
  {%- else %}
  <p class="entry__blurb">Nothing here yet.</p>
  {%- endfor %}
</section>
