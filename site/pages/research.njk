---
layout: page.njk
title: Research
permalink: /research/
---
<section class="list-page">
  <header class="page-head">
    <h1>Papers &amp; preprints</h1>
  </header>

  {%- for pub in publications | sortByYear %}
  <div class="entry">
    <h2 class="entry__title">
      {%- if pub.url %}<a href="{{ pub.url }}" target="_blank" rel="noopener">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif -%}
    </h2>
    <p class="entry__authors">{{ pub.authors | highlightAuthor(site.author) | safe }}</p>
    <p class="entry__meta note">
      <span class="venue">{{ pub.venue }}</span>{% if pub.note %}<span class="entry__note">{{ pub.note }}</span>{% endif %}
    </p>
  </div>
  {%- else %}
  <p class="entry__blurb">Nothing here yet.</p>
  {%- endfor %}
</section>
