---
layout: page.njk
title: Writing
permalink: /writing/
blog: true
---
<section class="post-index">
  <h1 class="post-title">Loose Collection of Thoughts</h1>
  <p class="post-count">{{ collections.posts.length | plural("post") }} so far.</p>

  <ul class="post-list">
    {%- for post in collections.posts %}
    <li>
      <span class="post-list__date">{{ post.date | shortDate }}</span>
      <a class="post-list__title" href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-list__tags">
        {%- if post.data.draft %}<span class="chip chip-draft">draft</span>{% endif %}
        {%- if post.data.tag %}<span class="chip">#{{ post.data.tag }}</span>{% endif %}
      </span>
    </li>
    {%- else %}
    <li>Nothing here yet.</li>
    {%- endfor %}
  </ul>
</section>
