<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and not isHome %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or blurb or site.description }}" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/atom.xml" />
    <script>
      (function () {
        var root = document.documentElement
        root.classList.add('js')
        try {
          var saved = localStorage.getItem('theme')
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved
        } catch (e) {}
      })()
    </script>
    <script src="/js/theme.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&family=Patrick+Hand&display=swap" />
    {% if '"katex' in content %}<link rel="stylesheet" href="/css/katex/katex.min.css" />{% endif %}
    <link rel="stylesheet" href="/css/styles.css" />
    {% if isHome %}<link rel="stylesheet" href="/css/home.css" />{% endif %}
  </head>
  <body{% if isHome %} class="home"{% elif blog %} class="blog"{% endif %}>
    {{ content | safe }}
  </body>
</html>
