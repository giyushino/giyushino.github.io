<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{% if pageTitle %}{{ pageTitle }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/theme.js"></script>
    {# A CSS background isn't discovered until the stylesheet has been parsed
       and the rule matched, which for a full-viewport scene is late. The hint
       starts the fetch during HTML parse instead.

       Each mode has its own art and only one of them will ever be painted, so
       the hint is emitted from script rather than as a static tag — theme.js
       has just stamped data-theme, so the mode is already known here and the
       other export is never fetched. #}
    {% if svgBg %}
    <script>
      (function () {
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        var l = document.createElement('link');
        l.rel = 'preload'; l.as = 'image'; l.type = 'image/svg+xml';
        l.href = '/img/' + (light ? '{{ svgBgLight or svgBg }}' : '{{ svgBg }}') + '.svg';
        document.head.appendChild(l);
      })();
    </script>
    {% endif %}
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body {% if screenLabel %}data-screen-label="{{ screenLabel }}"{% endif %}>
    {% if svgBg %}
    {# Both urls go on the element; the stylesheet picks between them by theme,
       so switching modes swaps the art with no second render path. #}
    <div id="svg-bg" aria-hidden="true" style="--svg-bg:url('/img/{{ svgBg }}.svg');--svg-bg-light:url('/img/{{ svgBgLight or svgBg }}.svg')"></div>
    {# Thousands of glyphs take a beat to rasterise however fast they arrive,
       and snapping in reads as a glitch. Fade instead. The class is added
       here rather than baked into the CSS so that with JS off the scene is
       simply visible from the start instead of stuck at opacity 0. #}
    <script>
      (function () {
        var el = document.getElementById('svg-bg');
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        var img = new Image();
        // Already in flight from the preload above, so this resolves off the
        // cache rather than costing a second request. Same pick as the hint —
        // waiting on the export the other mode uses would fade on a file this
        // page never paints.
        img.src = '/img/' + (light ? '{{ svgBgLight or svgBg }}' : '{{ svgBg }}') + '.svg';
        // A cache hit completes synchronously. Fading then would be a fade
        // from nothing to nothing — and worse, it would hand the view
        // transition a first frame with the scene still at zero, so the
        // background would appear to arrive after the page had already
        // swapped. Only the genuinely-uncached first visit fades.
        if (img.complete) return;
        el.classList.add('loading');
        img.onload = img.onerror = function () { el.classList.remove('loading'); };
      })();
    </script>
    {% endif %}
    {% if asciiScene %}<canvas id="ascii-bg" aria-hidden="true"></canvas>{% endif %}
    {% include "nav.njk" %}

    {{ content | safe }}

    {% if heroCanvas %}<script src="/js/ascii-brush.js"></script>{% endif %}
    {% if asciiScene %}
    <script src="/js/ascii-scene.js" defer></script>
    <script src="/js/ascii-bg.js" defer></script>
    {% endif %}
    <script src="/js/hue.js"></script>
  </body>
</html>
