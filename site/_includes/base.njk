<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {%- set fullTitle %}{% if title and not isHome %}{{ title }} · {% endif %}{{ site.title }}{% endset %}
    {%- set summary = description or blurb or site.description %}
    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ summary }}" />
    {#- Link previews (LinkedIn, iMessage, Slack, X...). Without og:image they grab the
        first <img> on the page, which on the home page is the blurred loading stand-in.
        og.jpg is the aquarium layers flattened to 1200x630; remake it if the art changes. #}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{{ fullTitle }}" />
    <meta property="og:description" content="{{ summary }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/img/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A girl walks along an aquarium railing while whale sharks and schools of fish glide through the blue tank beside her." />
    <meta name="twitter:card" content="summary_large_image" />
    {%- if draft %}
    <meta name="robots" content="noindex, nofollow" />
    {%- endif %}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/atom.xml" />
    <script>
      (function () {
        var root = document.documentElement
        root.classList.add('js')
        try {
          var saved = localStorage.getItem('theme')
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved
        } catch (e) {}
      })()
    </script>
    <script src="/js/theme.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&display=swap" />
    {% if '"katex' in content %}<link rel="stylesheet" href="/css/katex/katex.min.css" />{% endif %}
    <link rel="stylesheet" href="/css/styles.css" />
    {% if isHome %}<link rel="stylesheet" href="/css/home.css" />{% endif %}
  </head>
  <body{% if isHome %} class="home"{% elif blog %} class="blog"{% endif %}>
    {{ content | safe }}
  </body>
</html>
