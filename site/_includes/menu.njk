<ul class="menu">
  <li class="pill pill-square"><a class="tag" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}><strong>{{ site.initials }}</strong></a></li>
  {%- for item in nav.pages %}
  {%- set here = page.url == item.path or (page.url.startsWith(item.path) and item.path != "/") %}
  <li class="pill"><a class="tag" href="{{ item.path }}"{% if here %} aria-current="page"{% endif %}>{% if here %}<strong>{{ item.title }}</strong>{% else %}{{ item.title }}{% endif %}</a></li>
  {%- endfor %}
  {%- for item in nav.elsewhere %}
  {#- everything marked ↬ (CV included) opens in a new tab -#}
  <li class="pill"><a class="tag" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }} ↬</a></li>
  {%- endfor %}
  <li class="pill">
    <button class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><line x1="12" y1="1.5" x2="12" y2="3.5"/><line x1="12" y1="20.5" x2="12" y2="22.5"/><line x1="3.9" y1="3.9" x2="5.3" y2="5.3"/><line x1="18.7" y1="18.7" x2="20.1" y2="20.1"/><line x1="1.5" y1="12" x2="3.5" y2="12"/><line x1="20.5" y1="12" x2="22.5" y2="12"/><line x1="3.9" y1="20.1" x2="5.3" y2="18.7"/><line x1="18.7" y1="5.3" x2="20.1" y2="3.9"/></svg>
    </button>
  </li>
</ul>
