---
layout: page.njk
blog: true
---
{%- set minutes = content | readingMinutes %}
<article class="post">
  <h1 class="post-title">{{ title }}</h1>
  <p class="post-meta">
    {{ date | shortDate }}, {{ minutes }} min read
    {%- if updated %} · updated {{ updated | shortDate }}{% endif %}
  </p>
  {%- if tag or draft %}
  <p class="post-tags">
    {%- if draft %}<span class="chip chip-draft">draft</span>{% endif %}
    {%- if tag %}<span class="chip">#{{ tag }}</span>{% endif %}
  </p>
  {%- endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
