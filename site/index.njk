---
layout: base.njk
permalink: /
isHome: true
title: Home
layers:
  - { file: 0_water, speed: 0.08, settle: 3.5 }
  - { file: 1_far, speed: 0.3, settle: 3 }
  - { file: 2_sharks, speed: 0.5, settle: 2.5 }
  - { file: 3_near, speed: 0.75, settle: 2 }
  - { file: 4_walkway, speed: 1, settle: 1.5 }
---
<div class="scene" role="img" aria-label="A girl walks along an aquarium railing while whale sharks, a ray and schools of fish glide through the blue tank beside her.">
  {%- for layer in layers %}
  <div class="layer" data-speed="{{ layer.speed }}" style="--settle: {{ layer.settle }}s">
    <img class="placeholder" src="/img/aquarium/{{ layer.file }}-placeholder.webp" alt="" />
    <img class="main" src="/img/aquarium/{{ layer.file }}.webp" alt="" />
  </div>
  {%- endfor %}
</div>

<nav class="home-nav" aria-label="Site">
  <div class="narrow-unpadded">
    {% include "menu.njk" %}
  </div>
</nav>

<header class="home-name">
  <h1 class="title">{{ site.author }}</h1>
</header>

<script src="/js/home.js"></script>
